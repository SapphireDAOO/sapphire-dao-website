# Public build inputs.
#
# Copy to build-inputs.env, fill in the deployed values, and COMMIT IT.
# That is not a leak: NEXT_PUBLIC_* values are string-inlined into the client
# bundle by Next, so they are already readable by anyone with devtools open.
# They have to be published anyway -- a verifier who builds with different
# values gets a different root hash and cannot tell tampering from a mismatch.
#
# Only NEXT_PUBLIC_* belongs in this file. The server secrets in .env
# (SECRET_KEY, JWT_SECRET, GRAPH_API_KEY, NOTES_SECRET_KEY,
# NOTES_SIGNER_PRIVATE_KEY) are read at request time, never at build time. The
# reproducible build never receives them, and scripts/hash-build.mjs refuses to
# record any key without the NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_INFURA_ID=
NEXT_PUBLIC_NOTES_SIGNER_ADDRESS=

# Optional: falls back to a public RPC in src/app/api/notes/notesApiHelpers.ts
# when unset. Leave blank only if the deployed build also leaves it blank --
# a different value here produces a different root hash.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
